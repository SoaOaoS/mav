# ============================================================================
# Configuration du bot Telegram <-> opencode
# Copier ce fichier vers .env et le remplir, puis le référencer dans le service
# ============================================================================

# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_TOKEN=

# Identifiants des chats autorisés à utiliser le bot (séparés par des virgules)
ALLOWED_CHAT_IDS=

# URL de l'API opencode (serveur opencode serve)
OPENCODE_URL=http://127.0.0.1:4096/

# Modèle à utiliser (providerID/modelID)
OPENCODE_MODEL=ollama-cloud/deepseek-v4-flash

# Agent par défaut (ex: research, dev, ops...)
OPENCODE_AGENT=research

# Mode de réponse : 'last' (dernière réponse) ou 'all' (concaténation)
ANSWER_MODE=last

# Traiter le texte simple (sans commande) comme une question (1 = oui)
PLAIN_TEXT_IS_ASK=1

# Fichier d'état des sessions
STATE_FILE=/home/opencode/bot/sessions.json

# Afficher la progression en direct (1 = oui)
SHOW_PROGRESS=1

# Délai d'inactivité avant de considérer la tâche comme bloquée (secondes)
IDLE_TIMEOUT=1800

# Activer la mémoire inter-sessions (1 = oui)
MEMORY=1

# Nombre d'échanges mémorisés injectés
MEMORY_TOP=3

# Répertoire du bot (fichiers de données)
BOT_DIR=/home/opencode/bot

# Chats autorisés à utiliser /clear (séparés par des virgules, vide = désactivé)
CLEAR_ALLOWED_CHAT_IDS=
