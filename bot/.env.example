# ============================================================================
# Mav worker configuration (reference)
#
# NOTE: install.sh generates /etc/mav.env for you. This file only documents
# the available variables for manual setups.
# ============================================================================

# opencode API URL (opencode serve)
OPENCODE_URL=http://127.0.0.1:4096

# Model used by scheduled jobs (providerID/modelID)
OPENCODE_MODEL=

# Default agent for jobs (empty = opencode default)
OPENCODE_AGENT=

# Owner id: memory, facts and watch items are attached to it
MAV_CHAT_ID=0

# Data folder (jobs.json, push subscriptions, VAPID keys)
BOT_DIR=/home/USER/bot

# Idle timeout before considering a job stuck (seconds)
IDLE_TIMEOUT=1800

# Automatic retries for a failed job
JOB_RETRIES=1

# Seconds between two watch passes
WATCH_INTERVAL=300

# Postgres connection (memory, watch, RAG, notifications)
PG_DSN=host=127.0.0.1 port=5432 user=mav password=CHANGE_ME dbname=mav

# Quiet hours for push (e.g. 23-7, 0-0 to disable)
NOTIFY_QUIET=23-7

# VAPID contact (required for Web Push)
MAV_VAPID_SUB=mailto:admin@localhost
