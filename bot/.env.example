# ============================================================================
# Telegram bot <-> opencode configuration
#
# NOTE: this file is NOT used by install.sh (the wizard generates /etc/mav.env
# from your answers). It is a reference for manual setups and to see the
# available variables.
# ============================================================================

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# Chats allowed to use the bot (comma-separated)
ALLOWED_CHAT_IDS=

# opencode API URL (opencode serve)
OPENCODE_URL=http://127.0.0.1:4096/

# Model to use (providerID/modelID)
OPENCODE_MODEL=

# Default agent (leave empty for the opencode default)
OPENCODE_AGENT=

# Answer mode: 'last' (last answer) or 'all' (concatenation)
ANSWER_MODE=last

# Treat plain text (no command) as a question (1 = yes)
PLAIN_TEXT_IS_ASK=1

# Session state file
STATE_FILE=/home/USER/bot/sessions.json

# Show live progress (1 = yes)
SHOW_PROGRESS=1

# Idle timeout before considering a task stuck (seconds)
IDLE_TIMEOUT=1800

# Enable cross-session memory (1 = yes)
MEMORY=1

# Number of remembered exchanges to inject
MEMORY_TOP=3

# Bot directory (data files)
BOT_DIR=/home/USER/bot

# Postgres connection (memory, watch, RAG, notifications)
PG_DSN=host=127.0.0.1 port=5432 user=mav password=CHANGE_ME dbname=mav

# Quiet hours for push (e.g. 23-7, 0-0 to disable)
NOTIFY_QUIET=23-7

# VAPID contact (email, required for Web Push)
MAV_VAPID_SUB=mailto:admin@localhost

# Chats allowed to use /clear (comma-separated, empty = disabled)
CLEAR_ALLOWED_CHAT_IDS=
