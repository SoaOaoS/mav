# Mav — Docker settings. Copy to .env and adjust:   cp .env.example .env
# Everything is optional: with no model here, the web app's welcome screen
# helps you connect one.

# Version of the image (a release like v2.3.0, or latest).
MAV_VERSION=latest

# Where the web app listens on this machine. 0.0.0.0 = reachable from your
# network (the app asks for a password); 127.0.0.1 = this machine only.
MAV_BIND=0.0.0.0
MAV_PORT=8787

# Database password (letters and digits). Change it before the first start.
POSTGRES_PASSWORD=change-me-please

# Your time zone, for routine times (e.g. Europe/Paris, America/New_York).
TZ=UTC

# Optional: connect a model on the first start (afterwards: Settings → Model).
#   anthropic · openai · ollama · ollama-cloud-api · openrouter · custom
# MAV_PROVIDER=ollama
# MAV_MODEL=llama3.1
# MAV_BASE_URL=http://host.docker.internal:11434/v1
# MAV_PROVIDER_APIKEY=
